{
  "kind": "collectionType",
  "collectionName": "content_blocks",
  "info": {
    "singularName": "content-block",
    "pluralName": "content-blocks",
    "displayName": "Blocos do Card"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "image_url": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "card": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::card.card",
      "inversedBy": "content_blocks"
    },
    "content_rich_text": {
      "type": "blocks",
      "required": true
    },
    "sequence_marker": {
      "type": "enumeration",
      "required": true,
      "default": "none",
      "enum": [
        "none",
        "number"
      ]
    }
  }
}
